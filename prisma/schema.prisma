// Prisma Schema for Pizza House
// Database Models: User, Account, Session, VerificationToken, Pizza, Category, Order, OrderItem, Review, Coupon

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  address       String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]
  reviews  Review[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  image       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pizzas Pizza[]
}

model Pizza {
  id          String    @id @default(cuid())
  name        String
  description String
  image       String
  category    String
  categoryId  String?
  categoryRef Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  price       Float
  ingredients String    @default("[]") // JSON string of ingredients
  available   Boolean   @default(true)
  createdAt   DateTime  @default(now())

  orderItems OrderItem[]
  reviews    Review[]
}

model Order {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String   @default("Guest Customer")
  customerEmail String   @default("guest@pizzahouse.com")
  customerPhone String   @default("01000000000")
  customerAddress String?
  customerCity    String?
  notes           String?
  status        String   @default("Pending") // Pending, Preparing, Out For Delivery, Delivered, Cancelled
  paymentMethod String   @default("Cash on Delivery") // Cash on Delivery, Credit Card, Vodafone Cash
  paymentStatus String   @default("Paid") // Paid, Unpaid, Refunded
  total         Float
  createdAt     DateTime @default(now())

  items OrderItem[]
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pizzaId  String
  pizza    Pizza  @relation(fields: [pizzaId], references: [id], onDelete: Cascade)
  quantity Int
  size     String @default("Medium")
  toppings String @default("[]") // JSON string of toppings
  price    Float
}

model Review {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  pizzaId   String
  pizza     Pizza    @relation(fields: [pizzaId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  status    String   @default("Pending") // Pending, Approved, Rejected
  createdAt DateTime @default(now())
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  discount  Float // e.g. 15 for 15% off or fixed amount
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}
